<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halo Maidens: The Infinite Ring</title>
    <style>
        body {
            margin: 0;
            background: linear-gradient(to bottom, #1a1a2e, #0f0f1a); /* Nền game tối */
            text-align: center;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden; /* Ngăn cuộn trang */
        }
        h1 {
            background: linear-gradient(to right, #ff00cc, #3333ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 3.5em; /* Tăng cỡ chữ */
            margin-top: 30px;
            text-shadow: 0 0 15px rgba(255, 0, 204, 0.5), 0 0 15px rgba(51, 51, 255, 0.5); /* Hiệu ứng tỏa sáng */
        }
        canvas {
            border: 4px solid #4a4a6e; /* Viền canvas */
            background: #0d0d1a; /* Nền map */
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5); /* Đổ bóng nhẹ */
            display: block;
            margin: 20px auto;
        }
        .controls {
            margin-top: 30px;
            display: flex;
            justify-content: center;
            gap: 20px; /* Khoảng cách giữa các nút */
        }
        .btn {
            padding: 15px 35px;
            font-size: 1.2em;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            text-transform: uppercase;
        }
        .btn:hover {
            transform: translateY(-3px); /* Hiệu ứng nổi lên khi di chuột */
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3);
        }
        .btn-gacha {
            background: linear-gradient(to bottom, #ffdb58, #ffa500); /* Vàng cam */
            color: #4a2a00;
        }
        .btn-move {
            background: linear-gradient(to bottom, #7b68ee, #4169e1); /* Tím xanh */
            color: white;
        }
        .btn-inventory {
            background: linear-gradient(to bottom, #a0522d, #8b4513); /* Nâu đất */
            color: white;
        }
        #resultText {
            margin-top: 25px;
            min-height: 40px;
            font-size: 1.4em;
            font-weight: bold;
            color: #e0e0e0;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body>
    <h1>Halo Maidens: The Infinite Ring</h1>
    
    <canvas id="gameCanvas" width="800" height="450"></canvas>
    
    <div class="controls">
        <button class="btn btn-gacha" onclick="quayGacha()">QUAY GACHA!</button>
        <button class="btn btn-move" onclick="alert('Tính năng di chuyển sẽ được phát triển sau!')">DI CHUYỂN</button>
        <button class="btn btn-inventory" onclick="alert('Túi đồ sẽ hiển thị các nhân vật của bạn!')">TÚI ĐỒ</button>
    </div>

    <h2 id="resultText">Chào mừng đến với thế giới của Halo Maidens!</h2>

    <script src="shared/canvas-utils.js"></script>
    <script src="shared/gacha.js"></script>
    <script>
        const { canvas, ctx } = initCanvas("gameCanvas");

        const charWidth = 60;
        const charHeight = 90;
        const charSpacing = 100;

        let maleCharX = (canvas.width / 2) - charWidth - (charSpacing / 2);
        let femaleCharX = (canvas.width / 2) + (charSpacing / 2);
        let charY = (canvas.height / 2) - (charHeight / 2);

        function drawCharacters(maleColor, femaleColor) {
            clearCanvas(ctx, canvas, "#0d0d1a");

            ctx.fillStyle = maleColor;
            ctx.fillRect(maleCharX, charY, charWidth, charHeight);

            ctx.fillStyle = femaleColor;
            ctx.beginPath();
            ctx.arc(femaleCharX + (charWidth / 2), charY + (charHeight / 2), charWidth / 2, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = "white";
            ctx.font = "16px Arial";
            ctx.textAlign = "center";
            ctx.fillText("Anh h\u00f9ng Nam", maleCharX + charWidth / 2, charY + charHeight + 20);
            ctx.fillText("Thi\u1ebfu n\u1eef N\u1eef", femaleCharX + charWidth / 2, charY + charHeight + 20);
        }

        const FEMALE_COLORS = { SSR: "gold", SR: "#00ffff", R: "gray" };

        function quayGacha() {
            const result = rollGacha({ sr: 25 });
            displayGachaResult("resultText", result.tier, {
                SSR: { text: "\u2b50 SSR: Thi\u1ebfu n\u1eef \u00c1nh S\u00e1ng m\u1edbi!", color: "gold" },
                SR:  { text: "\u2728 SR: Chi\u1ebfn binh Gi\u00f3 m\u1edbi!",            color: "#00ffff" },
                R:   { text: "\ud83d\udc5f R: L\u00ednh th\u01b0\u1eddng!",             color: "#e0e0e0" },
            });
            drawCharacters("#3366ff", FEMALE_COLORS[result.tier]);
        }

        drawCharacters("#3366ff", "#ff69b4");
    </script>
</body>
</html>
