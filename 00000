<!DOCTYPE html>
<html>
<body style="margin:0; background:#222; display:flex; justify-content:center; align-items:center; height:100vh;">
    <div style="text-align:center;">
        <canvas id="gameCanvas" width="400" height="400" style="border:2px solid white;"></canvas>
        <br>
        <button onclick="quayGacha()" style="padding:10px 20px; margin-top:10px; cursor:pointer;">QUAY GACHA!</button>
        <p id="ketqua" style="color:white; font-family:sans-serif; font-size:20px;"></p>
    </div>

    <script src="shared/canvas-utils.js"></script>
    <script src="shared/gacha.js"></script>
    <script src="shared/input-handler.js"></script>
    <script>
        const { canvas, ctx } = initCanvas("gameCanvas");
        let x = 175, y = 175;

        function draw() {
            clearCanvas(ctx, canvas, "#000");
            ctx.fillStyle = "cyan";
            ctx.fillRect(x, y, 50, 50);
            requestAnimationFrame(draw);
        }

        function quayGacha() {
            const result = rollGacha();
            displayGachaResult("ketqua", result.tier, {
                SSR: { text: "\u2b50 SSR: SI\u00caU HI\u1ebeM!", color: "gold" },
                SR:  { text: "\u2728 SR: HI\u1ebeM",            color: "#00ffff" },
                R:   { text: "\ud83d\udc5f R: TH\u01af\u1edcNG", color: "#e0e0e0" },
            });
        }

        registerArrowKeys(function (dx, dy) {
            x += dx * 10;
            y += dy * 10;
        });

        draw();
    </script>
</body>
</html>
